# Server
NODE_ENV=development
PORT=4000

# Database
# Local dev: use SQLite (file:./dev.db) or a local PostgreSQL instance.
# Production: use a hosted PostgreSQL (Neon, Supabase, Render, etc.)
# Example Neon: "postgresql://user:password@ep-xxx.region.aws.neon.tech/habit-tracker?sslmode=require"
DATABASE_URL="postgresql://user:password@localhost:5432/habit-tracker?schema=public"

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173
