# Web app environment variables (Vite)
# Copy to .env.local for local development.

# API base URL.
# - Leave unset in development: Vite proxies /api to http://localhost:4000.
# - In production, set to your deployed API URL, e.g.:
#   VITE_API_URL=https://habit-tracker-api.onrender.com/api/v1
VITE_API_URL=
